ARG BASE_IMAGE=quarterly-recon:current-v14
FROM ${BASE_IMAGE}

ARG BUILD_SHA
ARG BUILD_TIME
ARG ENVIRONMENT=formal

WORKDIR /app

# The exact worktree has already completed a clean npm ci/build/test gate in
# server-build.sh. Preserve that generated dist in the image context so Docker
# packaging does not make a second network-dependent npm install.
COPY . .
ENV BUILD_SHA=$BUILD_SHA
ENV BUILD_TIME=$BUILD_TIME
ENV ENVIRONMENT=$ENVIRONMENT
RUN test -f dist/server/wrangler.json
RUN printf '{"gitSha":"%s","builtFrom":"exact-worktree","buildTime":"%s"}\n' "$BUILD_SHA" "$BUILD_TIME" > /app/release-metadata.json

ENV NODE_ENV=production
ENV WRANGLER_LOG_PATH=.wrangler/wrangler.log

EXPOSE 3000

CMD ["npx", "wrangler", "dev", "--config", "dist/server/wrangler.json", "--ip", "0.0.0.0", "--port", "3000", "--persist-to", ".wrangler"]
