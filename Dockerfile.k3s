# Server-only production image. It inherits the currently running image so
# deployment can be rebuilt on the isolated server without pulling Node from
# Docker Hub, then replaces the development command with the built runtime.
FROM quarterly-recon:current-v10

WORKDIR /app
COPY . .
RUN npm run build

ENV NODE_ENV=production
ENV WRANGLER_LOG_PATH=.wrangler/wrangler.log
EXPOSE 3000

CMD ["npx", "wrangler", "dev", "--config", "dist/server/wrangler.json", "--ip", "0.0.0.0", "--port", "3000", "--persist-to", ".wrangler"]
